# ==============================================================================
# EbarCity Athletics (ایبل‌سیتی اتلتیکس) - Environment Configuration Template
# Package ID: ir.ebarcity.athletics
# Author: Akbar Alimiri (Siavash / SE Amiri)
# ==============================================================================

# Server & App Environment
VITE_APP_NAME="EbarCity Athletics"
VITE_APP_ID="ir.ebarcity.athletics"
VITE_DEFAULT_LANG="fa" # Options: fa, en, ku, ur, tr

# Android Signing Automation Variables (for local build / CI CD)
SIGNING_STORE_FILE="keystore/ebarcity-release-key.jks"
SIGNING_STORE_PASSWORD="your_secure_store_password_here"
SIGNING_KEY_ALIAS="ebarkey"
SIGNING_KEY_PASSWORD="your_secure_key_password_here"

# Authentication Options (Dual Auth: Mobile + Gmail for Iran; Google OAuth for International)
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
VITE_SMS_GATEWAY_API_KEY="your_iran_sms_gateway_api_key_here"

# Optional Cloud API Key (Server-side proxy routes)
GEMINI_API_KEY="your_gemini_api_key_here"
